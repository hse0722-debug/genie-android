{
  "manifest_version": 3,
  "name": "지니 다중 계정 자동화 (앨범+곡 좋아요 & 다운)",
  "version": "8.5.2",
  "description": "지니뮤직 다중 계정 로그인, 앨범/곡 좋아요, 5단계 개별곡 결제 및 다운로드 즉시 계정 전환 엔진",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "*://*.genie.co.kr/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.genie.co.kr/*"],
      "js": ["alert_blocker.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.genie.co.kr/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}