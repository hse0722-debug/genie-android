/** 지니 시트 연결 서버 10.0.3 — 이 파일은 Apps Script에만 설치합니다. */
const GENIE_SEED_ID='1KS0avSMsGkba5zeDb2IZ_v2p1bJGW7uXm5hcDV_2q24';
const GENIE_ACCOUNT_ID='14SWMDCFfxYGFAuoTMxahDKTcranKXmyfVDu31SH7OEw';
function onOpen(){SpreadsheetApp.getUi().createMenu('지니 연동').addItem('1. 초기 설정','setupGenie').addItem('계정 파일 추가 허용','allowAccountFile').addToUi();}
function setupGenie(){const p=PropertiesService.getScriptProperties();if(!p.getProperty('ACCOUNT_IDS'))p.setProperty('ACCOUNT_IDS',JSON.stringify([GENIE_ACCOUNT_ID]));p.setProperty('SEED_ID',GENIE_SEED_ID);if(!p.getProperty('SEED_GID'))p.setProperty('SEED_GID','0');SpreadsheetApp.getUi().alert('설정 완료. 시드 파일의 gid가 0이 아니면 프로젝트 설정 → 스크립트 속성의 SEED_GID를 수정하세요. 다음으로 웹 앱을 배포하세요.');}
function allowAccountFile(){const ui=SpreadsheetApp.getUi(),r=ui.prompt('계정 파일 추가','허용할 Google 시트 주소 또는 파일 ID',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return;const value=r.getResponseText().trim(),id=(value.match(/\/d\/([\w-]+)/)||[])[1]||value;if(!/^[\w-]{20,}$/.test(id))throw Error('주소를 확인하세요.');SpreadsheetApp.openById(id);const p=PropertiesService.getScriptProperties(),ids=JSON.parse(p.getProperty('ACCOUNT_IDS')||'[]');p.setProperty('ACCOUNT_IDS',JSON.stringify([...new Set([...ids,id])]));ui.alert('허용했습니다. 같은 파일의 새 탭은 추가 설정 없이 사용할 수 있습니다.');}
function hashKey_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value)).map(n=>('0'+((n+256)%256).toString(16)).slice(-2)).join('');}
function json_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){return json_({ok:true,service:'genie-sheet',version:'10.0.3',message:'시트 연결용 POST 요청을 받습니다.'});}
function doPost(e){try{const raw=e&&e.postData&&e.postData.contents;if(!raw||raw.length>150000)throw Error('요청 크기 오류');const req=JSON.parse(raw),p=PropertiesService.getScriptProperties();if(req.action==='seeds')return json_({ok:true,seeds:seeds_(p)});if(!['catalog','accounts','claim','heartbeat','write','release'].includes(req.action))throw Error('지원하지 않는 요청입니다.');const ids=JSON.parse(p.getProperty('ACCOUNT_IDS')||'[]');if(!ids.includes(req.spreadsheetId))throw Error('관리자가 허용하지 않은 계정 파일입니다.');const book=SpreadsheetApp.openById(req.spreadsheetId),sheet=book.getSheets().find(s=>s.getSheetId()===Number(req.gid));if(!sheet)throw Error('탭(gid)을 찾을 수 없습니다.');const lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('다른 요청을 처리 중입니다. 다시 시도하세요.');try{const client={helpers:[...new Set(rows_(sheet).map(r=>r.helper))]};return json_(handle_(req,client,sheet,p));}finally{lock.releaseLock();}}catch(err){return json_({ok:false,error:String(err.message||'시트 요청 실패')});}}
function seeds_(p){const book=SpreadsheetApp.openById(p.getProperty('SEED_ID')||GENIE_SEED_ID),sheet=book.getSheets().find(s=>s.getSheetId()===Number(p.getProperty('SEED_GID')||0));if(!sheet)throw Error('시드 탭이 없습니다.');const cells=sheet.getRange('C3:D7').getDisplayValues(),out={};for(const [key,r,c] of [['album',0,0],['song',0,1],['mv',3,0],['artist',3,1]]){const name=String(cells[r][c]).trim(),sid=String(cells[r+1][c]).trim();if(!name&&!sid){out[key]={name:'',sid:''};continue;}if(!name||!/^\d+$/.test(sid))throw Error(key+' 이름·숫자 시드를 함께 입력하세요.');out[key]={name,sid};}return out;}
function rows_(sheet){const count=sheet.getLastRow()-2;if(count<1)return [];const rows=sheet.getRange(3,1,count,10).getDisplayValues(),passwords=sheet.getRange(3,10,count,1).getValues();let time='';return rows.map((r,i)=>{if(String(r[1]).trim())time=String(r[1]).trim();return {row:i+3,number:String(r[0]).trim(),time,helper:String(r[2]).trim(),id:String(r[3]).trim(),password:String(passwords[i][0]??''),results:{down:r[4],song:r[5],mv:r[6],album:r[7],artist:r[8]}};}).filter(r=>/^\d+$/.test(r.number)&&r.id&&r.helper);}
function leaseKey_(req,id){return 'LEASE_'+hashKey_('account:'+id);}
function pickRows_(req,client,sheet){if(!client.helpers.includes(String(req.helper)))throw Error('선택한 헬퍼가 C열에 없습니다.');const rows=rows_(sheet).filter(r=>r.helper===req.helper&&r.time===req.time);const seen=new Set();for(const row of rows){if(seen.has(row.id))throw Error('선택 범위에 중복 아이디가 있습니다.');seen.add(row.id);}return rows;}
function handle_(req,client,sheet,p){const rows=rows_(sheet).filter(r=>client.helpers.includes(r.helper));if(req.action==='catalog')return {ok:true,title:sheet.getName(),helpers:[...new Set(rows.map(r=>r.helper))],times:[...new Set(rows.map(r=>r.time).filter(Boolean))],pairs:[...new Map(rows.map(r=>[r.helper+'\u0000'+r.time,{helper:r.helper,time:r.time}])).values()]};const selected=pickRows_(req,client,sheet);if(req.action==='accounts'){const valid=selected.filter(r=>r.password.length>0);return {ok:true,title:sheet.getName(),accounts:valid,excluded:selected.length-valid.length};}if(!/^[\w-]{10,100}$/.test(req.jobId||''))throw Error('작업 ID 오류');const identity='open',now=Date.now();const requested=req.accounts||[];if(!Array.isArray(requested)||requested.length>2000)throw Error('계정 수 오류');const targets=requested.map(id=>{const row=selected.find(r=>r.id===id);if(!row)throw Error('계정 배정·시간이 변경되었습니다. 다시 불러오세요.');return row;});const leases=targets.map(row=>{const key=leaseKey_(req,row.id),value=JSON.parse(p.getProperty(key)||'null');if(value&&value.until>now&&(value.jobId!==req.jobId||value.owner!==identity))throw Error('다른 기기에서 사용 중인 계정이 있습니다.');return {row,key,value};});if(req.action==='release'){for(const item of leases)if(item.value&&item.value.jobId===req.jobId&&item.value.owner===identity)p.deleteProperty(item.key);return {ok:true};}if(req.action==='write'){const changes=req.changes;if(!Array.isArray(changes)||changes.length>100)throw Error('기록 수 오류');const columns={down:5,song:6,mv:7,album:8,artist:9};for(const change of changes){const item=leases.find(l=>l.row.id===change.id);if(!item||!columns[change.metric]||!['o','x'].includes(change.value))throw Error('허용되지 않은 결과 기록');}for(const value of ['o','x']){const ranges=changes.filter(c=>c.value===value).map(change=>{const row=leases.find(l=>l.row.id===change.id).row;return String.fromCharCode(64+columns[change.metric])+row.row;});if(ranges.length)sheet.getRangeList(ranges).setValue(value);}SpreadsheetApp.flush();return {ok:true,written:changes.length};}const updates={};for(const item of leases)updates[item.key]=JSON.stringify({jobId:req.jobId,owner:identity,until:now+180000});if(leases.length)p.setProperties(updates);return {ok:true,count:targets.length};}
